name:                haskell-gi-test
version:             0.1
synopsis:            Tests of haskell-gi
Description:         Tests of haskell-gi
homepage:            https://github.com/haskell-gi/haskell-gi
license:             LGPL-3
author:              Will Thompson,
                     Iñaki García Etxebarria,
                     Jonas Platte
maintainer:          Iñaki García Etxebarria (garetxe@gmail.com)
stability:           Experimental
category:            Development
build-type:          Simple
cabal-version:       1.24

source-repository head
  type: git
  location: https://github.com/haskell-gi/haskell-gi.git

executable testGtk
  default-language:    Haskell2010
  main-is:             testGtk.hs
  build-depends:       base >= 4.9 && < 5,
                       bytestring >= 0.10,
                       containers >= 0.5 && < 0.9,
                       random >= 1.1 && < 1.2,
                       haskell-gi-base >= 0.26.7 && < 1,
                       haskell-gi-overloading == 1.0.*,
                       gi-glib == 2.0.*,
                       gi-gdk3,
                       gi-gio == 2.0.*,
                       gi-giounix == 2.0.*,
                       gi-gobject == 2.0.*,
                       gi-gtk3,
                       text >= 1.0

  other-extensions:    OverloadedStrings, OverloadedLabels, LambdaCase, ScopedTypeVariables
  ghc-options:         -Wall -Wcompat -fwarn-incomplete-patterns -fno-warn-name-shadowing -threaded -with-rtsopts=-N

-- Check the struct layouts computed by haskell-gi against the C
-- compiler. This requires a C compiler, pkg-config, and the
-- development headers for the libraries being checked.
test-suite struct-layout
  type:                exitcode-stdio-1.0
  default-language:    Haskell2010
  main-is:             StructLayout.hs
  build-depends:       base >= 4.9 && < 5,
                       containers,
                       directory,
                       haskell-gi,
                       process,
                       text >= 1.0,
                       xml-conduit
  ghc-options:         -Wall -Wcompat -fno-warn-name-shadowing

-- Runtime checks of struct fields whose layout is wrong in the typelib.
test-suite struct-fields
  type:                exitcode-stdio-1.0
  default-language:    Haskell2010
  main-is:             StructFields.hs
  build-depends:       base >= 4.9 && < 5,
                       haskell-gi-base >= 0.26.7 && < 1,
                       gi-glib == 2.0.*,
                       gi-pango == 1.0.*,
                       gi-pangocairo == 1.0.*,
                       text >= 1.0
  ghc-options:         -Wall -Wcompat -fno-warn-name-shadowing

-- Regression tests for reported issues. The test for issue N lives in
-- the directory issues/N, with the Haskell side in issues/N/test.hs,
-- and the C side (if any) in issues/N/test.c.

-- https://github.com/haskell-gi/haskell-gi/issues/485
-- The "glyphs" field of PangoGlyphString was missing.
test-suite issue-485
  type:                exitcode-stdio-1.0
  default-language:    Haskell2010
  hs-source-dirs:      issues/485
  main-is:             test.hs
  c-sources:           issues/485/test.c
  pkgconfig-depends:   pango
  build-depends:       base >= 4.9 && < 5,
                       haskell-gi-base >= 0.26.7 && < 1,
                       -- For the overloaded attributes.
                       haskell-gi-overloading == 1.0.*,
                       gi-pango == 1.0.*,
                       gi-pangocairo == 1.0.*,
                       text >= 1.0
  ghc-options:         -Wall -Wcompat -fno-warn-name-shadowing
